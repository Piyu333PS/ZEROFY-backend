{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "30 3 * * *"
    }
  ]
}
